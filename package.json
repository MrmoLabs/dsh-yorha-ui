{
  "name": "dsh-yorha-ui",
  "version": "0.1.1",
  "packageManager": "pnpm@10.34.5",
  "description": "NieR:Automata (YoRHa) industrial terminal theme plugin for the DeepSeek Harness Web GUI",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "docs/yorha-ui-preview.svg",
    "README.md",
    "README.zh-CN.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "pretest": "pnpm run build",
    "test": "node --test",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=10 <11"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "cordis-plugin",
    "theme",
    "yorha",
    "nier-automata"
  ],
  "license": "MIT",
  "peerDependencies": {
    "react": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrmoLabs/dsh-yorha-ui.git"
  },
  "homepage": "https://github.com/MrmoLabs/dsh-yorha-ui#readme",
  "bugs": {
    "url": "https://github.com/MrmoLabs/dsh-yorha-ui/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "react": "^19.3.0",
    "typescript": "^5.4.0"
  }
}
